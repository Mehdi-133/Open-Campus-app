# Copy to .env.local for local overrides, then restart Vite.
# Public API base path for the future fetch client (include /api).
VITE_API_BASE_URL=/api

# Vite development proxy destination; not exposed to browser code.
API_PROXY_TARGET=http://localhost:3001

# Production hosting must forward /api to the backend, or use an absolute
# VITE_API_BASE_URL with backend CORS configured for the frontend origin.
# Never put database, JWT or SMTP secrets in VITE_ variables.
